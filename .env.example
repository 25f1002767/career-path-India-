# Flask Environment Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=change_this_to_a_secure_random_key_in_production
PORT=5000

# Database Configuration
# Leave empty to use local SQLite (sqlite:///careerpathindia.db), or provide PostgreSQL URL for Render/Production
# Example: postgresql://user:password@hostname:5432/mpath_db
DATABASE_URL=

# AI Career Mentor Keys (Optional, handled server-side only)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional external integration keys
RAPIDAPI_KEY=
